# Copy to backend/.env for local runs outside Docker. The app, Alembic and the
# test suite all read it, and real environment variables override it.
# Never commit real values.

# Postgres connection used by the API and by Alembic.
RIDEDESK_DATABASE_URL=postgresql+psycopg://ridedesk:ridedesk@localhost:5432/ridedesk

# Admin connection the test suite uses to create and drop its own database.
RIDEDESK_TEST_DATABASE_URL=postgresql+psycopg://ridedesk:ridedesk@localhost:5432/postgres
